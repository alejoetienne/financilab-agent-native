# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# ── Agent chat LLM (optional; all inbox actions work without one) ───────────
# Easiest: open the app and click "Use Builder.io" / Connect in the chat panel
# (managed Builder.io gateway; no key in this file). Or set ONE provider key:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=     # Gemini (GEMINI_API_KEY also accepted)
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# AGENT_ENGINE=anthropic            # force an engine instead of auto-detect

# ── scam-shield-core LLM layer (optional; default is offline rules only) ────
# Blends an LLM score into analyze-case. Needs the matching key above
# (anthropic → ANTHROPIC_API_KEY, openai → OPENAI_API_KEY,
#  gemini → GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY).
# SCAM_SHIELD_LLM=none              # anthropic | openai | gemini | none
# SCAM_SHIELD_ANTHROPIC_MODEL=claude-haiku-5-5
# SCAM_SHIELD_OPENAI_MODEL=gpt-4o-mini
# SCAM_SHIELD_GEMINI_MODEL=gemini-2.5-flash

# CLI identity for `pnpm action ...` (local dev only)
# AGENT_USER_EMAIL=dev@local.test
# AGENT_ORG_ID=
